# Normalize text files; board-side scripts must keep LF line endings
* text=auto

*.py      text eol=lf
*.sh      text eol=lf
*.service text eol=lf
*.c       text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.csv     text eol=lf
gradlew   text eol=lf
*.bat     text eol=crlf

*.onnx  binary
*.jar   binary
*.png   binary
*.jpg   binary
*.webp  binary
*.docx  binary
*.mp3   binary
*.wav   binary
